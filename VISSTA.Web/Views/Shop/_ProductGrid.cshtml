@model IReadOnlyCollection<ProductListDto>
<div class="catalog-grid">
@foreach (var product in Model)
{
    <article class="product-card">
        <div class="product-image">
            <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
            <button class="product-image-cta" type="button" data-quick-view-open data-product-slug="@product.Slug">Quick View</button>
            @if (product.DiscountValue is > 0)
            {
                <span class="discount-badge">@(product.DiscountType == "Fixed" ? $"-{product.DiscountValue.Value:N0} EGP" : $"-{(int)product.DiscountValue.Value}%")</span>
            }
        </div>
        <div class="product-meta">
            <h4>@product.Name</h4>
            @if (product.DiscountValue is > 0)
            {
                <div class="price-group">
                    <span class="price-original">@product.Price.ToString("N0") @product.Currency</span>
                    <span class="price-sale">@product.EffectivePrice.ToString("N0") @product.Currency</span>
                </div>
            }
            else
            {
                <p>@product.Price.ToString("N0") @product.Currency</p>
            }
        </div>
        <button class="text-button" type="button" data-quick-view-open data-product-slug="@product.Slug">Quick View</button>
    </article>
}
</div>
