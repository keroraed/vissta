@model IReadOnlyCollection<ProductListDto>
<div class="catalog-grid">
@foreach (var product in Model)
{
    <article class="product-card">
        <a class="product-image" asp-controller="Shop" asp-action="Detail" asp-route-slug="@product.Slug">
            <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
            <span>View Piece</span>
        </a>
        <div class="product-meta">
            <h4>@product.Name</h4>
            <p>@product.Price.ToString("N0") @product.Currency</p>
        </div>
        <form asp-controller="Cart" asp-action="Add" method="post" data-cart-form>
            <input type="hidden" name="productId" value="@product.Id" />
            <input type="hidden" name="quantity" value="1" />
            <button class="text-button" type="submit">Quick Add</button>
        </form>
    </article>
}
</div>
