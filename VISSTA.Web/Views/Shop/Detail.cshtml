@model ProductDetailViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = $"{Model.Product.Name} - VISSTA";
    var shareDescription = Model.Product.Description.Length > 155
        ? $"{Model.Product.Description[..152]}..."
        : Model.Product.Description;
    var configuredBaseUrl = Configuration["Site:PublicBaseUrl"]?.TrimEnd('/');
    var requestBaseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var publicBaseUrl = string.IsNullOrWhiteSpace(configuredBaseUrl) ? requestBaseUrl : configuredBaseUrl;
    var shareImagePath = Model.Product.Images.OrderByDescending(i => i.IsPrimary).ThenBy(i => i.DisplayOrder).Select(i => i.Url).FirstOrDefault() ?? "/assets/product-white-polo.webp";
    var shareImageUrl = shareImagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase)
        ? shareImagePath
        : $"{publicBaseUrl}{Url.Content(shareImagePath)}";
    var shareUrl = $"{publicBaseUrl}/shop/{Model.Product.Slug}";
    var sharePrice = Model.Product.EffectivePrice.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
@section Head {
    <meta name="description" content="@shareDescription" />
    <meta property="og:type" content="product" />
    <meta property="og:site_name" content="VISSTA" />
    <meta property="og:title" content="@Model.Product.Name" />
    <meta property="og:description" content="@shareDescription" />
    <meta property="og:url" content="@shareUrl" />
    <meta property="og:image" content="@shareImageUrl" />
    <meta property="og:image:secure_url" content="@shareImageUrl" />
    <meta property="product:price:amount" content="@sharePrice" />
    <meta property="product:price:currency" content="@Model.Product.Currency" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Model.Product.Name" />
    <meta name="twitter:description" content="@shareDescription" />
    <meta name="twitter:image" content="@shareImageUrl" />
}
<main class="simple-page">
    <section class="shell pdp">
        @{
            var galleryImages = Model.Product.Images.DefaultIfEmpty(new ProductImageDto(0, "/assets/product-white-polo.webp", true, 1)).ToList();
        }
        <div class="pdp-gallery" data-pdp-gallery>
            <div class="pdp-gallery-stack" style="position:relative">
                @for (var index = 0; index < galleryImages.Count; index++)
                {
                    var image = galleryImages[index];
                    <img class="pdp-gallery-image @(index == 0 ? "is-active" : null)" src="@image.Url" alt="@Model.Product.Name" loading="@(index == 0 ? "eager" : "lazy")" data-pdp-image />
                }
                @if (Model.Product.DiscountValue is > 0)
                {
                    <span class="discount-badge">@(Model.Product.DiscountType == "Fixed" ? $"-{Model.Product.DiscountValue.Value:N0} EGP" : $"-{(int)Model.Product.DiscountValue.Value}%")</span>
                }
            </div>
            @if (galleryImages.Count > 1)
            {
                <div class="pdp-gallery-controls" aria-label="Product images">
                    <button class="pdp-gallery-button" type="button" aria-label="Previous image" data-pdp-prev>&#8592;</button>
                    <span class="pdp-gallery-count" data-pdp-count>1 / @galleryImages.Count</span>
                    <button class="pdp-gallery-button" type="button" aria-label="Next image" data-pdp-next>&#8594;</button>
                </div>
            }
        </div>
        <div class="pdp-info">
            @{
                var hasAvailableSize = Model.Product.SizeStocks.Any(sizeStock => sizeStock.Stock > 0);
            }
            <p class="eyebrow">@Model.Product.CategoryName</p>
            <h1 class="section-title">@Model.Product.Name</h1>
            @if (Model.Product.DiscountValue is > 0)
            {
                <div class="pdp-price-group">
                    <span class="pdp-price-original">@Model.Product.Price.ToString("N0") @Model.Product.Currency</span>
                    <span class="pdp-price-sale">@Model.Product.EffectivePrice.ToString("N0") @Model.Product.Currency</span>
                    <span class="pdp-saved-badge">
                        You save @Model.Product.SavedAmount.ToString("N0") @Model.Product.Currency
                    </span>
                </div>
            }
            else
            {
                <p class="price">@Model.Product.Price.ToString("N0") @Model.Product.Currency</p>
            }
            <p class="section-copy">@Model.Product.Description</p>
            <form asp-controller="Cart" asp-action="Add" method="post" data-cart-form data-cart-add class="buy-box glassmorphism buy-box-modern" data-buy-box>
                <input type="hidden" name="productId" value="@Model.Product.Id" />
                <div class="buy-control">
                    <span>Size</span>
                    <div class="size-options" role="radiogroup" aria-label="Select size">
                        @foreach (var sizeStock in Model.Product.SizeStocks)
                        {
                            var inputId = $"size-{Model.Product.Id}-{sizeStock.Size}";
                            var isAvailable = sizeStock.Stock > 0;
                            <label class="size-chip @(isAvailable ? null : "is-disabled")" for="@inputId">
                                <input id="@inputId" type="radio" name="size" value="@sizeStock.Size" data-size-option data-stock="@sizeStock.Stock" disabled="@(!isAvailable)" required />
                                <span>@sizeStock.Size</span>
                                @if (!isAvailable)
                                {
                                    <small>Out</small>
                                }
                            </label>
                        }
                    </div>
                </div>
                <div class="buy-control quantity-control" data-quantity-control aria-hidden="true">
                    <span>Quantity</span>
                    <div class="quantity-stepper">
                        <button type="button" data-qty-minus aria-label="Decrease quantity">-</button>
                        <input type="number" min="1" max="@Model.Product.Stock" name="quantity" value="1" data-buy-quantity readonly />
                        <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
                    </div>
                    <small data-size-stock-note>Select a size to check availability.</small>
                </div>
                <button class="button button-primary" type="submit" disabled="@(!hasAvailableSize)">@(hasAvailableSize ? "Add to Cart" : "Out of Stock")</button>
            </form>
            @if (!string.IsNullOrWhiteSpace(Model.Product.CategorySizeChartImageUrl) || !string.IsNullOrWhiteSpace(Model.Product.CategoryWashingInstructionsImageUrl))
            {
                <div class="pdp-accordions" aria-label="Product information">
                    @if (!string.IsNullOrWhiteSpace(Model.Product.CategorySizeChartImageUrl))
                    {
                        <details class="pdp-accordion">
                            <summary>
                                <span>Size Chart</span>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                            </summary>
                            <div class="pdp-accordion-panel">
                                <img src="@Model.Product.CategorySizeChartImageUrl" alt="@Model.Product.CategoryName size chart" loading="lazy" />
                            </div>
                        </details>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Product.CategoryWashingInstructionsImageUrl))
                    {
                        <details class="pdp-accordion">
                            <summary>
                                <span>Washing Instructions</span>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                            </summary>
                            <div class="pdp-accordion-panel">
                                <img src="@Model.Product.CategoryWashingInstructionsImageUrl" alt="@Model.Product.CategoryName washing instructions" loading="lazy" />
                            </div>
                        </details>
                    }
                </div>
            }
        </div>
    </section>

    <section class="shell reviews" id="reviews">
        <div class="review-section-head">
            <div>
                <p class="eyebrow">Customer notes</p>
                <h2 class="compact-title">Reviews</h2>
            </div>
            @if (Model.Product.Reviews.Count > 1)
            {
                <div class="review-carousel-controls" aria-label="Review navigation">
                    <button class="review-nav-button" type="button" aria-label="Previous review" data-review-prev>&#8592;</button>
                    <button class="review-nav-button" type="button" aria-label="Next review" data-review-next>&#8594;</button>
                </div>
            }
        </div>

        @if (Model.Product.Reviews.Count == 0)
        {
            <div class="glassmorphism review-empty">
                <p>No reviews yet. Be the first to share your thoughts.</p>
            </div>
        }
        else
        {
            <div class="review-carousel" data-review-carousel>
                @foreach (var review in Model.Product.Reviews)
                {
                    var reviewerInitial = string.IsNullOrWhiteSpace(review.CustomerName) ? "V" : review.CustomerName.Trim()[0].ToString().ToUpperInvariant();
                    <article class="glassmorphism review-card">
                        <header class="review-card-head">
                            <span class="review-avatar" aria-hidden="true">@reviewerInitial</span>
                            <div>
                                <strong>@review.CustomerName</strong>
                                <span class="review-date">@review.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                            </div>
                        </header>
                        <div class="review-stars" aria-label="@review.Rating out of 5 stars">
                            @for (var star = 1; star <= 5; star++)
                            {
                                <span class="@(star <= review.Rating ? "is-filled" : null)" aria-hidden="true">&#9733;</span>
                            }
                        </div>
                        <p>@review.Body</p>
                    </article>
                }
            </div>
        }

        <form asp-controller="Review" asp-action="Submit" method="post" class="review-form glassmorphism">
            <input type="hidden" name="productId" value="@Model.Product.Id" />
            <input type="hidden" name="slug" value="@Model.Product.Slug" />
            <div class="review-form-head">
                <span>Rate this piece</span>
                <div class="star-rating" aria-label="Rating">
                    @for (var rating = 5; rating >= 1; rating--)
                    {
                        if (rating == 5)
                        {
                            <input type="radio" id="rating-@rating" name="rating" value="@rating" checked />
                        }
                        else
                        {
                            <input type="radio" id="rating-@rating" name="rating" value="@rating" />
                        }
                        <label for="rating-@rating" aria-label="@rating star@(rating == 1 ? "" : "s")">&#9734;</label>
                    }
                </div>
            </div>
            <textarea name="body" placeholder="Share your thoughts" required maxlength="1500"></textarea>
            <button class="button button-primary" type="submit">Submit Review</button>
        </form>
    </section>

    <section class="shell related">
        <div class="related-section-head">
            <h2 class="compact-title">Related Pieces</h2>
            <div class="related-nav-controls" aria-label="Related products navigation">
                <button class="related-nav-button" type="button" aria-label="Previous" data-related-prev>&#8592;</button>
                <button class="related-nav-button" type="button" aria-label="Next" data-related-next>&#8594;</button>
            </div>
        </div>
        @await Html.PartialAsync("_ProductGrid", Model.RelatedProducts)
    </section>
</main>
