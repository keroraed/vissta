@model ShopViewModel
@{
    var parentCategories = Model.Categories.Where(c => c.ParentCategoryId == null).OrderBy(c => c.Name).ToList();
    var childCategories = Model.Categories.Where(c => c.ParentCategoryId != null).ToList();
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.Search) || Model.CategoryId.HasValue || !string.IsNullOrWhiteSpace(Model.Sort);
}
<main class="simple-page">
    <section class="shell shop-header">
        <div>
            <p class="eyebrow">Shop</p>
            <h1 class="section-title">Quiet essentials, ready now.</h1>
        </div>
        <form class="filters glassmorphism filter-panel" method="get" data-filter-form>
            <label class="filter-control filter-search">
                <span>Search</span>
                <span class="filter-input-shell">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="m20 20-3.5-3.5"></path>
                    </svg>
                    <input type="search" name="search" value="@Model.Search" placeholder="Polo, tee, knit..." />
                </span>
            </label>
            <label class="filter-control filter-category">
                <span>Category</span>
                <select name="categoryId">
                    <option value="">All Categories</option>
                    @foreach (var parent in parentCategories)
                    {
                        var isSelected = Model.CategoryId == parent.Id;
                        <option value="@parent.Id" selected="@isSelected">@parent.Name</option>
                        @foreach (var child in childCategories.Where(c => c.ParentCategoryId == parent.Id).OrderBy(c => c.Name))
                        {
                            var isChildSelected = Model.CategoryId == child.Id;
                            <option value="@child.Id" selected="@isChildSelected">&nbsp;&nbsp;— @child.Name</option>
                        }
                    }
                </select>
            </label>
            <label class="filter-control filter-sort">
                <span>Sort</span>
                <select name="sort">
                    <option value="">Featured</option>
                    <option value="newest" selected="@(Model.Sort == "newest")">Newest</option>
                    <option value="price-asc" selected="@(Model.Sort == "price-asc")">Price Low</option>
                    <option value="price-desc" selected="@(Model.Sort == "price-desc")">Price High</option>
                </select>
            </label>
            <div class="filter-actions">
                <button class="button button-primary" type="submit">Apply</button>
                @if (hasActiveFilters)
                {
                    <a class="filter-clear" asp-controller="Shop" asp-action="Index">Clear</a>
                }
            </div>
        </form>
    </section>
    <section class="shell" data-catalog-target>
        @await Html.PartialAsync("_ProductGrid", Model.Products)
    </section>
    <div class="quick-view-overlay" data-quick-view-overlay></div>
    <section class="quick-view-modal glassmorphism" data-quick-view-modal aria-hidden="true" role="dialog" aria-modal="true" aria-label="Quick product view">
        <div class="quick-view-head">
            <span>Quick View</span>
            <button class="quick-view-close" type="button" data-quick-view-close aria-label="Close quick view">&times;</button>
        </div>
        <div class="quick-view-body" data-quick-view-body></div>
    </section>
</main>
