@model CartViewModel
<main class="simple-page">
    <section class="shell cart-page">
        <div class="cart-head">
            <p class="eyebrow">Cart</p>
            <h1 class="section-title">Your selection.</h1>
            @if (Model.Cart.Count > 0)
            {
                <p class="section-copy">@Model.Cart.Count item(s) reserved for checkout.</p>
            }
        </div>
        <div class="cart-list">
            @if (Model.Cart.Count == 0)
            {
                <article class="empty-state glassmorphism cart-empty">
                    <h2>Your cart is empty.</h2>
                    <p>Add a few essentials before checkout.</p>
                    <a class="button button-primary" asp-controller="Shop" asp-action="Index">Continue Shopping</a>
                </article>
            }
            else
            {
                @foreach (var item in Model.Cart.Items)
                {
                    <article class="cart-line glassmorphism" data-cart-line="@item.Id">
                        <a class="cart-line-image" asp-controller="Shop" asp-action="Detail" asp-route-slug="@item.Slug">
                            <img src="@item.ImageUrl" alt="@item.ProductName" />
                        </a>
                        <div class="cart-line-main">
                            <div>
                                <a class="cart-line-title" asp-controller="Shop" asp-action="Detail" asp-route-slug="@item.Slug">@item.ProductName</a>
                                <p>@item.UnitPrice.ToString("N0") @item.Currency</p>
                            </div>
                            <form class="cart-quantity-form" asp-controller="Cart" asp-action="Update" method="post" data-cart-form data-auto-cart-form>
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <label>
                                    <span>Qty</span>
                                    <input type="number" name="quantity" min="1" value="@item.Quantity" data-cart-quantity />
                                </label>
                            </form>
                        </div>
                        <div class="cart-line-total">
                            <span>Line total</span>
                            <strong data-line-total>@item.LineTotal.ToString("N0") @item.Currency</strong>
                        </div>
                        <form class="cart-remove-form" asp-controller="Cart" asp-action="Remove" method="post" data-cart-form>
                            <input type="hidden" name="cartItemId" value="@item.Id" />
                            <button class="text-button" type="submit">Remove</button>
                        </form>
                    </article>
                }
            }
        </div>
        <aside class="cart-summary cart-order-summary glassmorphism">
            @if (Model.Cart.Count == 0)
            {
                <p>Cart</p>
                <strong>Empty</strong>
                <a class="button button-secondary" asp-controller="Shop" asp-action="Index">Shop Now</a>
            }
            else
            {
                <div class="summary-head">
                    <p>Order summary</p>
                    <span data-summary-count>@Model.Cart.Count item(s)</span>
                </div>
                <div class="summary-row">
                    <span>Subtotal</span>
                    <strong data-cart-subtotal>@Model.Cart.Subtotal.ToString("N0") @Model.Cart.Currency</strong>
                </div>
                <div class="summary-note">Shipping and payment are confirmed in checkout.</div>
                <a class="button button-primary" asp-controller="Checkout" asp-action="Index">Checkout</a>
                <a class="summary-link" asp-controller="Shop" asp-action="Index">Continue shopping</a>
            }
        </aside>
    </section>
</main>
