@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Create New Password — VISSTA";
    ViewData["Description"] = "Set a new secure password for your VISSTA account.";
}

<main class="simple-page">
    <div class="shell">
        <div class="auth-card glassmorphism">
            <p class="auth-eyebrow">New Password</p>
            <h1 class="auth-heading">Create a new password</h1>
            <p class="auth-subtext">
                Your new password must be at least 8 characters and include uppercase, lowercase,
                a number, and a special character.
            </p>

            <form id="resetPasswordForm"
                  asp-controller="Account" asp-action="ResetPassword" method="post"
                  novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="OtpId" type="hidden" />
                <input asp-for="Email" type="hidden" />

                <div asp-validation-summary="All" class="form-summary"></div>

                <!-- New Password -->
                <div class="field-group" style="margin-bottom:20px;">
                    <label class="auth-label" asp-for="NewPassword">New Password</label>
                    <div class="password-field">
                        <input asp-for="NewPassword"
                               id="newPasswordInput"
                               type="password"
                               class="vissta-input"
                               placeholder="Min. 8 characters"
                               autocomplete="new-password"
                               data-password-input />
                        <button type="button"
                                class="password-toggle"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-password-toggle>
                            <span class="password-icon password-icon-show" aria-hidden="true">
                                <svg viewBox="0 0 24 24" focusable="false">
                                    <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"></path>
                                    <circle cx="12" cy="12" r="3.2"></circle>
                                </svg>
                            </span>
                            <span class="password-icon password-icon-hide" aria-hidden="true">
                                <svg viewBox="0 0 24 24" focusable="false">
                                    <path d="M3 5l16 16"></path>
                                    <path d="M10.6 10.6a2.5 2.5 0 0 0 3.5 3.5"></path>
                                    <path d="M6.3 6.3C4 8 2 12 2 12s3.5 6 10 6c1.7 0 3.2-.3 4.5-.9"></path>
                                    <path d="M12 6c3.2 0 5.7 1.4 7.4 3 1.2 1.1 2.1 2.3 2.6 3-.3.5-.7 1.1-1.2 1.8"></path>
                                </svg>
                            </span>
                        </button>
                    </div>
                    <!-- Password strength bar -->
                    <div class="strength-bar" id="strengthBar" aria-hidden="true">
                        <span id="seg1"></span>
                        <span id="seg2"></span>
                        <span id="seg3"></span>
                        <span id="seg4"></span>
                    </div>
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>

                <!-- Confirm Password -->
                <div class="field-group" style="margin-bottom:28px;">
                    <label class="auth-label" asp-for="ConfirmPassword">Confirm Password</label>
                    <div class="password-field">
                        <input asp-for="ConfirmPassword"
                               id="confirmPasswordInput"
                               type="password"
                               class="vissta-input"
                               placeholder="Repeat your password"
                               autocomplete="new-password"
                               data-password-input />
                        <button type="button"
                                class="password-toggle"
                                aria-label="Show confirm password"
                                aria-pressed="false"
                                data-password-toggle>
                            <span class="password-icon password-icon-show" aria-hidden="true">
                                <svg viewBox="0 0 24 24" focusable="false">
                                    <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"></path>
                                    <circle cx="12" cy="12" r="3.2"></circle>
                                </svg>
                            </span>
                            <span class="password-icon password-icon-hide" aria-hidden="true">
                                <svg viewBox="0 0 24 24" focusable="false">
                                    <path d="M3 5l16 16"></path>
                                    <path d="M10.6 10.6a2.5 2.5 0 0 0 3.5 3.5"></path>
                                    <path d="M6.3 6.3C4 8 2 12 2 12s3.5 6 10 6c1.7 0 3.2-.3 4.5-.9"></path>
                                    <path d="M12 6c3.2 0 5.7 1.4 7.4 3 1.2 1.1 2.1 2.3 2.6 3-.3.5-.7 1.1-1.2 1.8"></path>
                                </svg>
                            </span>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

                <button id="updateBtn"
                        type="submit"
                        class="button button-primary"
                        style="width:100%;">
                    Update Password
                </button>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    <script>
        (function () {
            var pwInput = document.getElementById('newPasswordInput');
            var segs    = [
                document.getElementById('seg1'),
                document.getElementById('seg2'),
                document.getElementById('seg3'),
                document.getElementById('seg4')
            ];
            var COLORS = ['#e05252', '#d4912a', '#D4AF73', '#4caf7d'];

            function evalStrength(pw) {
                var score = 0;
                if (pw.length >= 8)          score++;
                if (/[A-Z]/.test(pw))        score++;
                if (/[0-9]/.test(pw))        score++;
                if (/[^A-Za-z0-9]/.test(pw)) score++;
                return score;
            }

            pwInput.addEventListener('keyup', function () {
                var score = this.value.length === 0 ? 0 : evalStrength(this.value);
                segs.forEach(function (seg, i) {
                    seg.style.background = i < score ? COLORS[score - 1] : 'rgba(255,255,255,.1)';
                });
            });
        }());
    </script>
}
