@model AccountOrdersViewModel
<main class="simple-page">
    <section class="shell">
        <p class="eyebrow">Orders</p>
        <h1 class="section-title">Order History</h1>
        @if (Model.Orders.Count == 0)
        {
            <div class="empty-state glassmorphism">
                <h2 class="compact-title">No orders yet</h2>
                <p class="section-copy">Your order history will appear here once you place your first order.</p>
                <a class="button button-primary" asp-controller="Shop" asp-action="Index">Go shopping</a>
            </div>
        }
        else
        {
            <div class="table-list">
                @foreach (var order in Model.Orders)
                {
                    <a class="glassmorphism table-row order-row" asp-controller="Account" asp-action="Order" asp-route-id="@order.Id">
                        <span>#@order.Id</span>
                        <span>@order.Status</span>
                        <span>@order.TotalAmount.ToString("N0") @order.Currency</span>
                        <span>@order.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                        <span class="button button-primary button-small order-details-button">Details</span>
                    </a>
                }
            </div>
        }
    </section>
</main>
