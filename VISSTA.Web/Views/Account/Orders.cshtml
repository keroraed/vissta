@model AccountOrdersViewModel
<main class="simple-page">
    <section class="shell">
        <p class="eyebrow">Orders</p>
        <h1 class="section-title">Order History</h1>
        <div class="table-list">
            @foreach (var order in Model.Orders)
            {
                <article class="glassmorphism table-row">
                    <span>#@order.Id</span><span>@order.Status</span><span>@order.TotalAmount.ToString("N0") @order.Currency</span><span>@order.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                </article>
            }
        </div>
    </section>
</main>
