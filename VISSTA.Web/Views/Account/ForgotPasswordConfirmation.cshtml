@model ForgotPasswordConfirmationViewModel
@{
    ViewData["Title"] = "Check Your Inbox — VISSTA";
    ViewData["Description"] = "A 6-digit reset code has been sent to your email address.";
}

<main class="simple-page">
    <div class="shell">
        <div class="auth-card glassmorphism" style="text-align:center;">

            <!-- Checkmark icon ring -->
            <div class="success-ring" style="margin-bottom:28px;">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
                     stroke="#D4AF73" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
            </div>

            <p class="auth-eyebrow">Code Sent</p>
            <h1 class="auth-heading" style="font-size:1.65rem;">Check your inbox</h1>
            <p class="auth-subtext">
                We've sent a 6-digit code to<br>
                <strong style="color:var(--cream);font-weight:600;">@Model.MaskedEmail</strong><br>
                The code expires in 10 minutes.
            </p>

            <a asp-controller="Account" asp-action="VerifyOtp" asp-route-email="@Model.Email"
               class="button button-primary"
               style="display:flex;width:100%;justify-content:center;align-items:center;margin-bottom:12px;">
                Enter Code &rarr;
            </a>

            <!-- Resend: re-POST to ForgotPassword with email hidden -->
            <form asp-controller="Account" asp-action="ForgotPassword" method="post"
                  style="margin-bottom:16px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Email" value="@(TempData.Peek("ResetEmail") ?? string.Empty)" />
                <button type="submit" class="button button-secondary"
                        style="width:100%;font-size:0.78rem;">
                    Didn't receive it? Resend
                </button>
            </form>

            <p style="color:rgba(245,241,234,0.35);font-size:0.72rem;letter-spacing:0.06em;">
                Check your spam folder if you don't see it.
            </p>

            <p style="margin-top:20px;">
                <a asp-controller="Account" asp-action="ForgotPassword" class="auth-link">← Start over</a>
            </p>
        </div>
    </div>
</main>
