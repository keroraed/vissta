@{
    ViewData["Title"] = "Password Updated — VISSTA";
    ViewData["Description"] = "Your VISSTA account password has been successfully updated.";
}

<main class="simple-page">
    <div class="shell">
        <div class="auth-card glassmorphism" style="text-align:center;">

            <!-- Animated checkmark ring -->
            <div class="success-ring" style="margin-bottom:28px;">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none"
                     stroke="#D4AF73" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
            </div>

            <p class="auth-eyebrow">Success</p>
            <h1 class="auth-heading">Password updated</h1>
            <p class="auth-subtext">
                Your VISSTA account is secure.<br>
                You'll be redirected to login shortly.
            </p>

            <!-- Countdown text -->
            <p id="redirectCountdown"
               style="color:rgba(245,241,234,0.4);font-size:0.72rem;
                      letter-spacing:0.1em;margin-bottom:28px;">
                Redirecting in <span id="countNum">3</span>…
            </p>

            <a id="loginBtn"
               asp-controller="Account" asp-action="Login"
               class="button button-primary"
               style="display:block;width:100%;text-align:center;">
                Go to Login
            </a>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        (function () {
            var count    = 3;
            var countEl  = document.getElementById('countNum');
            var interval = setInterval(function () {
                count--;
                if (countEl) countEl.textContent = count;
                if (count <= 0) {
                    clearInterval(interval);
                    window.location.href = '/Account/Login';
                }
            }, 1000);

            // Also set a hard fallback
            window.setTimeout(function () {
                window.location.href = '/Account/Login';
            }, 3000);
        }());
    </script>
}
