@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password — VISSTA";
    ViewData["Description"] = "Reset your VISSTA account password by entering your registered email address.";
}

<main class="simple-page">
    <div class="shell">
        <div class="auth-card glassmorphism">
            <p class="auth-eyebrow">Account Recovery</p>
            <h1 class="auth-heading">Forgot your password?</h1>
            <p class="auth-subtext">
                Enter the email address linked to your VISSTA account and we'll send you a reset code.
            </p>

            <form id="forgotPasswordForm"
                  asp-controller="Account" asp-action="ForgotPassword" method="post"
                  novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="form-summary"></div>

                <div class="field-group" style="margin-bottom:20px;">
                    <label class="auth-label" asp-for="Email">Email Address</label>
                    <input asp-for="Email"
                           id="Email"
                           type="email"
                           class="vissta-input"
                           placeholder="your@email.com"
                           autocomplete="email"
                           required />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <button id="submitBtn"
                        type="submit"
                        class="button button-primary"
                        style="width:100%;margin-top:8px;">
                    <span id="btnText">Send Reset Code</span>
                </button>
            </form>

            <p style="text-align:center;margin-top:24px;">
                <a asp-controller="Account" asp-action="Login" class="auth-link">← Back to Login</a>
            </p>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('forgotPasswordForm');
            const btn  = document.getElementById('submitBtn');
            const txt  = document.getElementById('btnText');

            form.addEventListener('submit', function () {
                btn.disabled = true;
                txt.textContent = 'Sending…';
            });
        }());
    </script>
}
