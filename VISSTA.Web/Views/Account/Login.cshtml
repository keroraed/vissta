@model LoginViewModel
<main class="simple-page auth-page">
    <section class="auth-card glassmorphism">
        <p class="eyebrow">Account</p>
        <h1 class="compact-title">Welcome back</h1>
        <form class="auth-form" asp-controller="Account" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="form-summary"></div>
            <label class="field">
                <span>Email</span>
                <input asp-for="Email" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </label>
            <label class="field">
                <span>Password</span>
                <div class="password-field">
                    <input asp-for="Password" type="password" placeholder="Your password" autocomplete="current-password" data-password-input />
                    <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false" data-password-toggle>
                        <span class="password-icon password-icon-show" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"></path>
                                <circle cx="12" cy="12" r="3.2"></circle>
                            </svg>
                        </span>
                        <span class="password-icon password-icon-hide" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M3 5l16 16"></path>
                                <path d="M10.6 10.6a2.5 2.5 0 0 0 3.5 3.5"></path>
                                <path d="M6.3 6.3C4 8 2 12 2 12s3.5 6 10 6c1.7 0 3.2-.3 4.5-.9"></path>
                                <path d="M12 6c3.2 0 5.7 1.4 7.4 3 1.2 1.1 2.1 2.3 2.6 3-.3.5-.7 1.1-1.2 1.8"></path>
                            </svg>
                        </span>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </label>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:2px;margin-bottom:10px;">
                <label class="check" style="margin-top:0;"><input asp-for="RememberMe" type="checkbox" /> <span>Remember me</span></label>
                <a asp-controller="Account" asp-action="ForgotPassword"
                   style="color:var(--gold);font-size:.72rem;letter-spacing:.08em;border-bottom:1px solid rgba(212,175,115,.35);">
                    Forgot password?
                </a>
            </div>
            <input asp-for="ReturnUrl" type="hidden" />
            <button class="button button-primary auth-submit" type="submit">Login</button>
        </form>
        <p class="auth-switch">New to VISSTA? <a asp-controller="Account" asp-action="Register">Create an account</a></p>
    </section>
</main>

@section Scripts {
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
}
