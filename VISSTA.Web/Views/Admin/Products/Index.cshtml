@model AdminProductsViewModel
@{
    Layout = "_AdminLayout";
}
<section class="admin-head">
    <h1>Products</h1>
    <div class="admin-head-actions">
        <a class="button button-secondary" href="/admin/settings/stock">Stock Settings</a>
        <a class="button button-primary" href="/admin/products/create">Create</a>
    </div>
</section>
@if (TempData["ProductAdminMessage"] is string message)
{
    <div class="form-summary admin-message">@message</div>
}
<div class="table-list">
@foreach (var product in Model.Products)
{
    <article class="table-row glassmorphism admin-product-row admin-product-row--list">
        <div class="admin-product-media">
            <img class="admin-product-image" src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
        </div>
        <div class="admin-product-info">
            <strong class="admin-product-name">@product.Name</strong>
            <small class="admin-product-meta">@product.CategoryName</small>
        </div>
        <div class="admin-product-metric">
            <span class="admin-product-label">Price</span>
            <strong>@product.Price.ToString("N0") @product.Currency</strong>
        </div>
        <div class="admin-product-metric">
            <span class="admin-product-label">Stock</span>
            <strong>@product.Stock</strong>
        </div>
        <div class="admin-product-status">
            <span class="status-pill">@(product.IsActive ? "Active" : "Inactive")</span>
            @if (product.IsFeatured)
            {
                <small>Featured</small>
            }
            @if (product.ShowOnHomePage)
            {
                <small class="admin-home-flag" title="Shown on Home Page">🏠 Home</small>
            }
            @if (product.DiscountValue is > 0)
            {
                <span class="admin-list-discount-badge">
                    @if (product.DiscountType == "Fixed") { <text>−@((int)product.DiscountValue!.Value) EGP</text> }
                    else { <text>−@((int)product.DiscountValue!.Value)%</text> }
                </span>
            }
        </div>
        <div class="admin-row-actions">
            <a class="text-button" href="/admin/products/edit/@product.Id">Edit</a>
            <form method="post" action="/admin/products/delete/@product.Id">
                @Html.AntiForgeryToken()
                <button class="text-button" type="submit">Delete</button>
            </form>
        </div>
    </article>
}
</div>
