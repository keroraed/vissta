@model AdminProductsViewModel
@{
    Layout = "_AdminLayout";
}
<section class="admin-head"><h1>Products</h1><a class="button button-primary" href="/admin/products/create">Create</a></section>
<div class="table-list">
@foreach (var product in Model.Products)
{
    <article class="table-row glassmorphism"><span>@product.Name</span><span>@product.Price.ToString("N0") @product.Currency</span><span>Stock @product.Stock</span><a href="/admin/products/edit/@product.Id">Edit</a></article>
}
</div>
