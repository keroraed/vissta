@model AdminProductFormViewModel
<form method="post" class="admin-form glassmorphism" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="form-summary"></div>
    <input asp-for="Name" placeholder="Name" />
    <input asp-for="Slug" placeholder="Slug" />
    <textarea asp-for="Description" placeholder="Description"></textarea>
    <input asp-for="Sku" type="hidden" />
    @if (Model.ExistingImages.Count > 0)
    {
        <text>
            <div class="admin-image-grid" data-existing-images>
                @foreach (var image in Model.ExistingImages)
                {
                    <label class="admin-image-card">
                        <img src="@image.Url" alt="Product image" loading="lazy" />
                        <span class="admin-image-remove">
                            <input type="checkbox" name="RemoveImageIds" value="@image.Id" />
                            Remove
                        </span>
                    </label>
                }
            </div>
        </text>
    }
    <input id="ImageFiles" name="ImageFiles" type="file" multiple accept="image/*" data-image-upload />
    <div class="admin-image-preview" data-image-preview></div>
    <input asp-for="Price" type="number" step="0.01" placeholder="Price" />
    <div class="admin-size-stock-grid">
        @for (int i = 0; i < Model.SizeStocks.Count; i++)
        {
            <div class="admin-size-stock-item">
                <input type="hidden" asp-for="SizeStocks[i].SizeId" />
                <input type="hidden" asp-for="SizeStocks[i].SizeName" />
                <label class="check">
                    <input asp-for="SizeStocks[i].IsAvailable" type="checkbox" id="HasSize-@Model.SizeStocks[i].SizeId" />
                    <span>@Model.SizeStocks[i].SizeName size</span>
                </label>
                <div class="admin-size-stock-input-wrap" id="Stock-@Model.SizeStocks[i].SizeId-wrap">
                    <span>Stock</span>
                    <input asp-for="SizeStocks[i].Stock" type="number" min="0" placeholder="0" />
                </div>
            </div>
        }
    </div>
    <select asp-for="CategoryId">
        <option value="0">Select category</option>
        @foreach (var category in Model.Categories)
        {
            <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
        }
    </select>
    <label class="check"><input asp-for="IsFeatured" /> Featured</label>
    <label class="check"><input asp-for="IsActive" /> Active</label>
    <label class="check"><input asp-for="ShowOnHomePage" /> Show on Home Page (New Collection)</label>

    <div class="admin-discount-row">
        <div class="admin-discount-field">
            <span class="admin-field-label">Discount</span>
            <div class="admin-discount-controls">
                <select asp-for="DiscountType" id="DiscountType" class="admin-discount-type-select">
                    <option value="Percentage">Percentage (%)</option>
                    <option value="Fixed">Fixed Amount (EGP)</option>
                </select>
                <div class="admin-discount-input-wrap">
                    <input asp-for="DiscountValue" type="number" min="0" step="0.01" placeholder="0" id="DiscountValue" />
                    <span class="admin-discount-suffix" id="discount-suffix">%</span>
                </div>
            </div>
            <small class="admin-field-hint">Leave 0 for no discount. Percentage: 0–100. Fixed: absolute amount deducted.</small>
        </div>
        <div id="discount-preview" class="admin-discount-preview" style="display:none">
            <span class="admin-discount-badge-preview" id="discount-badge-text"></span>
        </div>
    </div>

    <button class="button button-primary" type="submit">Save</button>
</form>
<script>
    (function() {
        var typeSelect = document.getElementById('DiscountType');
        var valueInput = document.getElementById('DiscountValue');
        var preview   = document.getElementById('discount-preview');
        var badge     = document.getElementById('discount-badge-text');
        var suffix    = document.getElementById('discount-suffix');
        function update() {
            var type = typeSelect.value;
            var val  = parseFloat(valueInput.value);
            suffix.textContent = type === 'Percentage' ? '%' : 'EGP';
            if (val > 0) {
                badge.textContent = type === 'Percentage'
                    ? '\u2212' + Math.round(val) + '%'
                    : '\u2212' + val.toLocaleString('en-EG') + ' EGP';
                preview.style.display = 'flex';
            } else {
                preview.style.display = 'none';
            }
        }
        if (typeSelect) { typeSelect.addEventListener('change', update); }
        if (valueInput) { valueInput.addEventListener('input', update); update(); }

        var sizeIds = @Json.Serialize(Model.SizeStocks.Select(x => x.SizeId));
        function toggleSizeStock(sizeId) {
            var checkbox = document.getElementById('HasSize-' + sizeId);
            var wrap = document.getElementById('Stock-' + sizeId + '-wrap');
            if (checkbox && wrap) {
                var input = wrap.querySelector('input');
                if (checkbox.checked) {
                    wrap.style.opacity = '1';
                    wrap.style.pointerEvents = 'auto';
                    if (input) {
                        input.disabled = false;
                    }
                } else {
                    wrap.style.opacity = '0.35';
                    wrap.style.pointerEvents = 'none';
                    if (input) {
                        input.disabled = true;
                        input.value = '0';
                    }
                }
            }
        }
        sizeIds.forEach(function(sizeId) {
            var checkbox = document.getElementById('HasSize-' + sizeId);
            if (checkbox) {
                checkbox.addEventListener('change', function() { toggleSizeStock(sizeId); });
                toggleSizeStock(sizeId);
            }
        });
    })();
</script>
