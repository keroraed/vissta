@model AdminProductFormViewModel
<form method="post" class="admin-form glassmorphism" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="form-summary"></div>
    <input asp-for="Name" placeholder="Name" />
    <input asp-for="Slug" placeholder="Slug" />
    <textarea asp-for="Description" placeholder="Description"></textarea>
    @if (Model.ExistingImages.Count > 0)
    {
        <text>
            <div class="admin-image-grid" data-existing-images>
                @foreach (var image in Model.ExistingImages)
                {
                    <label class="admin-image-card">
                        <img src="@image.Url" alt="Product image" loading="lazy" />
                        <span class="admin-image-remove">
                            <input type="checkbox" name="RemoveImageIds" value="@image.Id" />
                            Remove
                        </span>
                    </label>
                }
            </div>
        </text>
    }
    <input id="ImageFiles" name="ImageFiles" type="file" multiple accept="image/*" data-image-upload />
    <div class="admin-image-preview" data-image-preview></div>
    <input asp-for="Price" type="number" step="0.01" placeholder="Price" />
    <input asp-for="Stock" type="number" placeholder="Stock" />
    <input asp-for="Sku" placeholder="SKU" />
    <select asp-for="CategoryId"><option value="1">Women's</option><option value="2">Men's</option><option value="3">Accessories</option></select>
    <label class="check"><input asp-for="IsFeatured" /> Featured</label>
    <label class="check"><input asp-for="IsActive" /> Active</label>
    <button class="button button-primary" type="submit">Save</button>
</form>
