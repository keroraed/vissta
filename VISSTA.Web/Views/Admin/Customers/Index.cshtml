@model AdminCustomersViewModel
@{
    Layout = "_AdminLayout";
}
<section class="admin-head"><h1>Customers</h1></section>
<div class="table-list">
@foreach (var customer in Model.Customers)
{
    <article class="table-row glassmorphism admin-customer-row">
        <span data-label="Name">@customer.FullName</span>
        <span data-label="Email">@customer.Email</span>
        <span data-label="Phone">@customer.PhoneNumber</span>
    </article>
}
</div>
