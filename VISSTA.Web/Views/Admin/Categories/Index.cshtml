@model AdminCategoriesViewModel
@{
    Layout = "_AdminLayout";
    var categoryLookup = Model.Categories.ToDictionary(c => c.Id, c => c.Name);
}
<section class="admin-head">
    <h1>Categories</h1>
    <a class="button button-primary" href="/admin/categories/create">Create</a>
</section>
@if (TempData["CategoryAdminMessage"] is string message)
{
    <div class="form-summary admin-message">@message</div>
}
<div class="table-list">
@foreach (var category in Model.Categories)
{
    <article class="table-row glassmorphism admin-category-row" style="grid-template-columns: 50px minmax(0, 1.2fr) minmax(0, 1.2fr) minmax(0, 1fr) auto; align-items: center;">
        <span class="admin-category-image" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: rgba(212,175,115,0.05); border: 1px solid rgba(212,175,115,0.12); border-radius: 4px; overflow: hidden; margin-right: 8px;">
            @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
            {
                <img src="@category.ImageUrl" alt="Category Image" style="width: 100%; height: 100%; object-fit: cover;" />
            }
            else
            {
                <span style="font-size: 0.5rem; color: rgba(245,241,234,0.25); text-transform: uppercase; font-family: sans-serif;">None</span>
            }
        </span>
        <span>@category.Name</span>
        <span>@category.Slug</span>
        <span>@(category.ParentCategoryId is null ? "-" : categoryLookup.GetValueOrDefault(category.ParentCategoryId.Value, "-"))</span>
        <div class="admin-row-actions">
            <a class="text-button" href="/admin/categories/edit/@category.Id">Edit</a>
            <form method="post" action="/admin/categories/delete/@category.Id">
                @Html.AntiForgeryToken()
                <button class="text-button" type="submit">Delete</button>
            </form>
        </div>
    </article>
}
</div>
