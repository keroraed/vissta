@model AdminSizeFormViewModel

<form method="post" class="admin-form glassmorphism">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="form-summary"></div>
    <input type="hidden" asp-for="Id" />
    <label class="field">
        <span>Size Name</span>
        <input asp-for="Name" placeholder="e.g. S, M, XL, 2XL" required />
        <span asp-validation-for="Name" class="field-error"></span>
    </label>
    <label class="field">
        <span>Display Order</span>
        <input asp-for="DisplayOrder" type="number" min="0" required />
        <span asp-validation-for="DisplayOrder" class="field-error"></span>
    </label>
    <div class="admin-form-actions">
        <a class="button button-secondary" href="/admin/sizes">Cancel</a>
        <button class="button button-primary" type="submit">Save Size</button>
    </div>
</form>
