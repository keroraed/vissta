@model AdminReviewsViewModel
@{
    Layout = "_AdminLayout";
}

<section class="admin-head">
    <div>
        <p>Moderation</p>
        <h1>Reviews</h1>
    </div>
    <span class="admin-muted">@Model.Reviews.Count review@(Model.Reviews.Count == 1 ? "" : "s")</span>
</section>

<section class="admin-panel glassmorphism admin-review-panel">
    @if (Model.Reviews.Count == 0)
    {
        <p class="admin-muted">No reviews found.</p>
    }
    else
    {
        <div class="admin-review-list">
            @foreach (var item in Model.Reviews)
            {
                var review = item.Review;
                var stars = new string('*', review.Rating).PadRight(5, '-');
                <article class="admin-review-card">
                    <div>
                        <span class="admin-stars">@stars</span>
                        <strong>@review.ProductName</strong>
                        <small>@review.CustomerName - @review.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</small>
                    </div>
                    <p>@review.Body</p>
                    <div class="admin-review-actions">
                        <span class="status-pill">@(review.IsApproved ? "Approved" : "Pending")</span>
                        <button type="button" class="admin-review-customer-toggle" data-customer-toggle aria-expanded="false">Customer</button>
                        @if (!string.IsNullOrWhiteSpace(review.ProductSlug))
                        {
                            <a href="/shop/@review.ProductSlug" target="_blank" rel="noreferrer">View product</a>
                        }
                        @if (!review.IsApproved)
                        {
                            <form method="post" action="/admin/reviews/@review.Id/approve">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="/admin/reviews" />
                                <button type="submit">Approve</button>
                            </form>
                        }
                    </div>
                    <div class="admin-review-customer" data-customer-panel>
                        <span>Name: @review.CustomerName</span>
                        <span>Email: @item.CustomerEmail</span>
                        <span>Phone: @review.CustomerPhone</span>
                        <span>Id: @review.CustomerId</span>
                    </div>
                </article>
            }
        </div>
    }
</section>
