@model AdminCouponFormViewModel

<form method="post" class="admin-form glassmorphism">
    <div asp-validation-summary="ModelOnly" class="form-summary"></div>
    <label class="field">
        <span>Code</span>
        <input asp-for="Code" placeholder="VISSTA10" />
        <span asp-validation-for="Code" class="field-error"></span>
    </label>
    <label class="field">
        <span>Discount Type</span>
        <select asp-for="DiscountType" asp-items="Html.GetEnumSelectList<VISSTA.Domain.Enums.DiscountType>()"></select>
        <span asp-validation-for="DiscountType" class="field-error"></span>
    </label>
    <label class="field">
        <span>Value</span>
        <input asp-for="Value" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="Value" class="field-error"></span>
    </label>
    <label class="field">
        <span>Expiry Date</span>
        <input asp-for="ExpiryDate" type="date" />
        <span asp-validation-for="ExpiryDate" class="field-error"></span>
    </label>
    <label class="field">
        <span>Max Uses</span>
        <input asp-for="MaxUses" type="number" min="1" />
        <span asp-validation-for="MaxUses" class="field-error"></span>
    </label>
    <label class="check">
        <input asp-for="IsActive" type="checkbox" />
        <span>Active</span>
    </label>
    <div class="admin-form-actions">
        <a class="button button-secondary" href="/admin/coupons">Cancel</a>
        <button class="button button-primary" type="submit">Save Coupon</button>
    </div>
</form>
