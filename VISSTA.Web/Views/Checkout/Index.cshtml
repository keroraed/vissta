@model CheckoutViewModel
<main class="simple-page">
    <section class="shell checkout">
        <div>
            <p class="eyebrow">Checkout</p>
            <h1 class="section-title">Finish with care.</h1>
            <form asp-controller="Checkout" asp-action="Confirm" method="post" class="checkout-form checkout-address-form glassmorphism" data-checkout-form>
                <div asp-validation-summary="ModelOnly" class="form-summary"></div>
                @if (!(User.Identity?.IsAuthenticated ?? false))
                {
                    <div class="form-grid checkout-inline-fields">
                        <label class="field">
                            <span>Name</span>
                            <input asp-for="GuestName" placeholder="Full name" />
                            <span asp-validation-for="GuestName" class="field-error"></span>
                        </label>
                        <label class="field">
                            <span>Email</span>
                            <input asp-for="GuestEmail" placeholder="you@example.com" />
                            <span asp-validation-for="GuestEmail" class="field-error"></span>
                        </label>
                        <label class="field">
                            <span>Phone</span>
                            <input asp-for="GuestPhone" placeholder="Phone number" />
                            <span asp-validation-for="GuestPhone" class="field-error"></span>
                        </label>
                    </div>
                }
                @if (Model.HasSavedAddress)
                {
                    <div class="address-options">
                        <input class="address-radio" id="UseSavedAddressTrue" name="UseSavedAddress" type="radio" value="true" checked="@Model.UseSavedAddress" />
                        <label class="address-choice" for="UseSavedAddressTrue">
                            <span>Saved address</span>
                            <strong>@Model.SavedAddress!.Street</strong>
                            <small>@Model.SavedAddress.City, @Model.SavedAddress.Governorate</small>
                            <small>@Model.SavedAddress.PostalCode @Model.SavedAddress.Country</small>
                            <button
                                type="button"
                                class="text-button address-edit"
                                data-edit-saved-address
                                data-street="@Model.SavedAddress.Street"
                                data-city="@Model.SavedAddress.City"
                                data-governorate="@Model.SavedAddress.Governorate"
                                data-postal="@Model.SavedAddress.PostalCode"
                                data-country="@Model.SavedAddress.Country">
                                Edit
                            </button>
                        </label>

                        <input class="address-radio" id="UseSavedAddressFalse" name="UseSavedAddress" type="radio" value="false" checked="@(!Model.UseSavedAddress)" />
                        <label class="address-choice address-choice-new" for="UseSavedAddressFalse">
                            <span>New address</span>
                            <strong>Add another delivery address</strong>
                            <small>Use this order only.</small>
                        </label>

                        <div class="new-address-fields" data-address-fields>
                            <label class="field">
                                <span>Street</span>
                                <input asp-for="ShippingAddress.Street" placeholder="Street" />
                            </label>
                            <label class="field">
                                <span>City</span>
                                <input asp-for="ShippingAddress.City" placeholder="City" />
                            </label>
                            <label class="field">
                                <span>Governorate</span>
                                <input asp-for="ShippingAddress.Governorate" placeholder="Governorate" />
                            </label>
                            <label class="field">
                                <span>Postal code</span>
                                <input asp-for="ShippingAddress.PostalCode" placeholder="Postal code" />
                            </label>
                            <label class="field">
                                <span>Country</span>
                                <input asp-for="ShippingAddress.Country" placeholder="Country" />
                            </label>
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-grid checkout-inline-fields">
                        <label class="field">
                            <span>Street</span>
                            <input asp-for="ShippingAddress.Street" placeholder="Street" />
                        </label>
                        <label class="field">
                            <span>City</span>
                            <input asp-for="ShippingAddress.City" placeholder="City" />
                        </label>
                        <label class="field">
                            <span>Governorate</span>
                            <input asp-for="ShippingAddress.Governorate" placeholder="Governorate" />
                        </label>
                        <label class="field">
                            <span>Postal code</span>
                            <input asp-for="ShippingAddress.PostalCode" placeholder="Postal code" />
                        </label>
                        <label class="field">
                            <span>Country</span>
                            <input asp-for="ShippingAddress.Country" placeholder="Country" />
                        </label>
                    </div>
                }
                <input asp-for="PaymentToken" type="hidden" value="mock" />
                <div class="checkout-action-row">
                    <div class="coupon-input-row">
                        <input asp-for="CouponCode" placeholder="Coupon code" data-coupon-input />
                        <span class="summary-coupon-status" data-summary-coupon-status aria-hidden="true">&#10003;</span>
                    </div>
                    <button class="button button-primary" type="submit">Confirm Order</button>
                </div>
            </form>
        </div>
        <aside class="cart-summary checkout-summary glassmorphism">
            <div class="summary-head">
                <p>Order summary</p>
                <span>@Model.Cart.Count item(s)</span>
            </div>
            <div class="checkout-summary-items">
                @foreach (var item in Model.Cart.Items)
                {
                    <article class="summary-item">
                        <img src="@item.ImageUrl" alt="@item.ProductName" />
                        <div>
                            <h3>@item.ProductName</h3>
                            <p>Size @item.Size - Qty @item.Quantity</p>
                        </div>
                        <strong>@item.LineTotal.ToString("N0") @item.Currency</strong>
                    </article>
                }
            </div>
            <div class="summary-row">
                <span>Subtotal</span>
                <strong data-summary-subtotal data-subtotal="@Model.Cart.Subtotal" data-currency="@Model.Cart.Currency">@Model.Cart.Subtotal.ToString("N0") @Model.Cart.Currency</strong>
            </div>
            <div class="summary-row is-hidden" data-summary-discount-row>
                <span>Discount</span>
                <strong data-summary-discount>-0 @Model.Cart.Currency</strong>
            </div>
            <div class="summary-row summary-total">
                <span>Total</span>
                <strong data-summary-total>@Model.Cart.Subtotal.ToString("N0") @Model.Cart.Currency</strong>
            </div>
        </aside>
    </section>
</main>
