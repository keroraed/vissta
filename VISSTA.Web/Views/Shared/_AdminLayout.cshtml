<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VISSTA Admin</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <header class="admin-mobile-bar">
        <a class="brand" asp-controller="Home" asp-action="Index">VISSTA</a>
        <button class="admin-menu-toggle" type="button" data-admin-menu-open aria-label="Open admin menu" aria-controls="admin-sidebar" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </header>
    <div class="admin-sidebar-overlay" data-admin-menu-overlay></div>
    <aside class="admin-sidebar" id="admin-sidebar" data-admin-sidebar aria-hidden="true">
        <button class="admin-menu-close" type="button" data-admin-menu-close aria-label="Close admin menu">×</button>
        <a class="brand" asp-controller="Home" asp-action="Index">VISSTA</a>
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/products">Products</a>
        <a href="/admin/categories">Categories</a>
        <a href="/admin/reviews">Reviews</a>
        <a href="/admin/newsletter">Newsletter</a>
        <a href="/admin/orders">Orders</a>
        <a href="/admin/settings/payments">Payments</a>
        <a href="/admin/coupons">Coupons</a>
        <a href="/admin/customers">Customers</a>
    </aside>
    <main class="admin-main">
        <div class="admin-global-actions">
            <div class="admin-notifications" data-admin-notifications>
                <button class="admin-notification-button" type="button" aria-label="Open notifications" aria-expanded="false" data-notification-toggle>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                        <path d="M13.7 21a2 2 0 0 1-3.4 0"></path>
                    </svg>
                    <span class="admin-notification-badge" data-notification-count hidden>0</span>
                </button>
                <div class="admin-notification-menu" data-notification-menu hidden>
                    <div class="admin-notification-menu-head">
                        <strong>Notifications</strong>
                        <button type="button" data-notification-read-all>Mark all read</button>
                    </div>
                    <div class="admin-notification-list" data-notification-list>
                        <p class="admin-notification-empty">No notifications yet.</p>
                    </div>
                </div>
            </div>
        </div>
        @RenderBody()
    </main>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/admin-products.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
