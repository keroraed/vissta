@using MediatR
@using VISSTA.Application.Features.Cart
@using VISSTA.Application.Features.Categories
@using VISSTA.Application.Interfaces
@using VISSTA.Web.Models
@inject IMediator Mediator
@inject ICurrentUserService CurrentUser
@{
    var layoutCart = await Mediator.Send(new GetCartQuery(CurrentUser.UserId, CurrentUser.SessionId));
    var navCategories = await Mediator.Send(new GetCategoryListQuery());
    var navParentCats = navCategories.Where(c => c.ParentCategoryId == null).OrderBy(c => c.Name).ToList();
    var navChildCats = navCategories.Where(c => c.ParentCategoryId != null).ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VISSTA - Quiet Luxury</title>
    <link rel="icon" type="image/png" href="~/assets/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="site-nav" data-nav>
        <div class="nav-inner">
            <button class="icon-button mobile-only" type="button" data-mobile-open aria-label="Open menu">
                <span></span><span></span>
            </button>

            <a class="brand" asp-controller="Home" asp-action="Index">VISSTA</a>

            <div class="nav-links">
                <a asp-controller="Home" asp-action="Index">HOME</a>
                <a asp-controller="Shop" asp-action="Index">SHOP</a>
                <div class="nav-collection-wrap" data-collection-nav>
                    <button class="nav-collection-trigger" type="button" data-collection-toggle aria-expanded="false" aria-haspopup="true">
                        COLLECTION
                        <svg class="nav-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    <div class="nav-collection-panel glassmorphism" data-collection-panel aria-hidden="true">
                        <div class="nav-collection-inner">
                            @foreach (var parent in navParentCats)
                            {
                                var children = navChildCats.Where(c => c.ParentCategoryId == parent.Id).OrderBy(c => c.Name).ToList();
                                <div class="nav-col-group">
                                    <a class="nav-col-heading" asp-controller="Collection" asp-action="Index" asp-route-slug="@parent.Slug">
                                        @if (!string.IsNullOrWhiteSpace(parent.ImageUrl))
                                        {
                                            <span class="nav-col-thumb" style="background-image:url('@parent.ImageUrl')"></span>
                                        }
                                        @parent.Name
                                    </a>
                                    @if (children.Count > 0)
                                    {
                                        <ul class="nav-col-list">
                                            @foreach (var child in children)
                                            {
                                                <li><a asp-controller="Collection" asp-action="Index" asp-route-slug="@child.Slug">@child.Name</a></li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }

                        </div>
                    </div>
                </div>
                <a asp-controller="Home" asp-action="About">ABOUT</a>
            </div>

            <div class="nav-actions">
                <button class="nav-icon" type="button" data-search-toggle aria-label="Search">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
                </button>
                <div class="account-menu desktop-only" data-account-menu>
                    <button class="nav-icon" type="button" data-account-toggle aria-expanded="false" aria-label="Account menu">
                        <svg viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    </button>
                    <div class="account-dropdown glassmorphism" data-account-dropdown>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="/admin/dashboard">Dashboard</a>
                            }
                            <a asp-controller="Account" asp-action="Profile">Profile</a>
                            <a asp-controller="Account" asp-action="Orders">Orders</a>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login">Login</a>
                            <a asp-controller="Account" asp-action="Register">Create account</a>
                        }
                    </div>
                </div>
                <a class="nav-icon cart-link" asp-controller="Cart" asp-action="Index" aria-label="Cart">
                    <svg viewBox="0 0 24 24"><path d="M6 7h12l-1 14H7L6 7Z"></path><path d="M9 7a3 3 0 0 1 6 0"></path></svg>
                    <span class="cart-badge" data-cart-count>@layoutCart.Count</span>
                </a>
            </div>
        </div>

        <div class="mobile-menu-overlay" id="mobile-menu-overlay"></div>

        <div class="mobile-menu" data-mobile-menu aria-hidden="true">
            <div class="mobile-menu-header">
                <span class="mobile-menu-brand">VISSTA</span>
                <button class="mobile-close" type="button" data-mobile-close aria-label="Close menu">×</button>
            </div>
            <div class="mobile-menu-spacer"></div>
            <a asp-controller="Home" asp-action="Index">HOME</a>
            <a asp-controller="Shop" asp-action="Index">SHOP</a>

            <div class="mobile-collection-group" data-mobile-collection>
                <span class="mobile-collection-label" data-mobile-collection-toggle>COLLECTION</span>
                <div class="mobile-cat-sections-wrap">
                @foreach (var parent in navParentCats)
                {
                    var mobileChildren = navChildCats.Where(c => c.ParentCategoryId == parent.Id).OrderBy(c => c.Name).ToList();
                    <div class="mobile-cat-section">
                        <a class="mobile-cat-parent" asp-controller="Collection" asp-action="Index" asp-route-slug="@parent.Slug">@parent.Name</a>
                        @if (mobileChildren.Count > 0)
                        {
                            <div class="mobile-cat-children">
                                @foreach (var child in mobileChildren)
                                {
                                    <a class="mobile-cat-child-link" asp-controller="Collection" asp-action="Index" asp-route-slug="@child.Slug">@child.Name</a>
                                }
                            </div>
                        }
                    </div>
                }
                </div>
            </div>

            <a asp-controller="Home" asp-action="About">ABOUT</a>

            <div class="mobile-menu-divider"></div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="mobile-menu-account-label">MY ACCOUNT</span>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/admin/dashboard">DASHBOARD</a>
                }
                <a asp-controller="Account" asp-action="Profile">PROFILE</a>
                <a asp-controller="Account" asp-action="Orders">ORDERS</a>
                <div class="mobile-menu-footer">
                    <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                        <button type="submit" class="mobile-close-button" style="width:100%;min-height:46px;border:1px solid rgba(212,175,115,.3);border-radius:999px;background:rgba(212,175,115,.08);color:var(--gold);text-transform:uppercase;letter-spacing:.18em;font-size:.7rem;font-weight:600;cursor:pointer;">LOGOUT</button>
                    </form>
                </div>
            }
            else
            {
                <div class="mobile-menu-footer">
                    <a asp-controller="Account" asp-action="Login">LOGIN</a>
                </div>
            }
        </div>


        <div class="search-panel" data-search-panel>
            <input type="search" data-search-input placeholder="Search VISSTA" autocomplete="off" />
            <div class="search-results" data-search-results></div>
        </div>
    </nav>

    @await Html.PartialAsync("_Notification", new NotificationViewModel(TempData["Message"] as string))
    @RenderBody()
    <div class="cart-overlay" data-cart-overlay></div>
    @await Html.PartialAsync("_CartSidebar", new CartViewModel(layoutCart))

    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-grid">
                <div>
                    <h4>Brand</h4>
                    <p class="footer-brand-copy">Quiet luxury essentials crafted for a life well-dressed.</p>
                </div>
                <div>
                    <h4>Shop</h4>
                    <a asp-controller="Shop" asp-action="Index">New Arrivals</a>
                    <a asp-controller="Shop" asp-action="Index" asp-route-search="shirt">Shirts</a>
                </div>
                <div>
                    <h4>Company</h4>
                    <a asp-controller="Home" asp-action="About">About</a>
                    <a href="#">Sustainability</a>
                    <a href="#">Stores</a>
                    <a href="#">Careers</a>
                </div>
                <div>
                    <h4>Social</h4>
                    <div class="social-links" aria-label="VISSTA social links">
                        <a class="social-icon" href="https://www.instagram.com/vissta.eg/" target="_blank" rel="noreferrer" aria-label="Instagram">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                                <circle cx="12" cy="12" r="4"></circle>
                                <circle cx="17.5" cy="6.5" r="1"></circle>
                            </svg>
                            <span class="sr-only">Instagram</span>
                        </a>
                        <a class="social-icon" href="https://www.facebook.com/profile.php?id=61576275821044" target="_blank" rel="noreferrer" aria-label="Facebook">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M14 8h2V4h-2.8C10.9 4 9 5.9 9 8.2V11H6v4h3v5h4v-5h3l1-4h-4V8.2c0-.1.1-.2.2-.2H14Z"></path>
                            </svg>
                            <span class="sr-only">Facebook</span>
                        </a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 VISSTA. All rights reserved.</p>
                <div><a href="#">Privacy Policy</a><a href="#">Terms of Service</a></div>
            </div>
        </div>
    </footer>

    @Html.AntiForgeryToken()
    <script src="~/js/animations.js" asp-append-version="true"></script>
    <script src="~/js/search.js" asp-append-version="true"></script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
